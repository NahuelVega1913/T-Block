<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- Overlay principal -->
    <FrameLayout
        android:id="@+id/overlay_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_proteccion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Card principal de protección -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/red_accent"
            app:strokeWidth="2dp"
            android:background="@color/card_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="30dp">

                <!-- Icono de candado -->
                <TextView
                    android:id="@+id/icon_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="120sp"
                    android:layout_marginBottom="20dp"/>

                <!-- Título principal -->
                <TextView
                    android:id="@+id/title_protection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTECCIÓN ACTIVA"
                    android:textSize="28sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="15dp"/>

                <!-- Línea separadora -->
                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:background="@color/red_accent"
                    android:layout_marginBottom="30dp"/>

                <!-- Mensaje -->
                <TextView
                    android:id="@+id/message_protection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No se puede desinstalar ni mover esta aplicación."
                    android:textSize="16sp"
                    android:textColor="@color/text_light"
                    android:gravity="center"
                    android:layout_marginBottom="30dp"
                    android:lineSpacingExtra="5dp"/>

                <!-- Card de información -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/card_light"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiempo de protección"
                            android:textSize="12sp"
                            android:textColor="@color/text_gray"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/dias_restantes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 días"
                            android:textSize="24sp"
                            android:textColor="@color/red_accent"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Botón de cerrar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cerrar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Cerrar"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/red_accent"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>